# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (Local Docker Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pipeline_db"

# Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min16chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min16chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
# Allow any user to make themselves an ADMIN (signup checkbox / "Become Admin" button). Set to false to disable.
ALLOW_SELF_ADMIN=true

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Detection Engine Settings
DETECTION_INTERVAL_MS=10000
DETECTION_SAMPLE_SIZE=5
DETECTION_PRESSURE_DROP_THRESHOLD_PCT=15
DETECTION_FLOW_MISMATCH_TOLERANCE_PCT=10
DETECTION_MIN_SUSTAINED_TICKS=3
# Optional — if set, this overrides the tick threshold for the flow-only WARNING path independently.
# If not set, DETECTION_MIN_SUSTAINED_TICKS is used for both signals.
# DETECTION_FLOW_MIN_SUSTAINED_TICKS=3

# Temperature Awareness Settings
# Linear baseline flow adjustment factor per °C deviation from historical average (default 0.002 = 0.2%/°C)
TEMP_FLOW_ADJUSTMENT_FACTOR=0.002
# High temperature hazard threshold in °C (default 65°C based on API 521 solar/ambient ceiling)
TEMP_DANGER_THRESHOLD_C=65
# Optional: override sustained reading ticks required for high temperature anomaly (defaults to DETECTION_MIN_SUSTAINED_TICKS)
# TEMP_MIN_SUSTAINED_TICKS=3

# Alerting & Email Configuration
RESEND_API_KEY=re_123456789...
ALERT_EMAIL_FROM=alerts@pipeline-detection.local

# Web Push Notification Configuration (VAPID)
# Note: Generate production keys with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY="BKa3R9F2m1q4w7e0r3t6y9u2i5o8p1a4s7d0f3g6h9j2k5l8z1x4c7v0b3n6m9A2S5D8F1G4H7J0K3L6M9N2O5P"
VAPID_PRIVATE_KEY="8f3K9d2M5p8X1v4B7n0Q3w6E9r2T5y8U1i4O7p0A3s6"
VAPID_SUBJECT="mailto:admin@pipeline-detection.local"

